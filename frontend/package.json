{
  "name": "frontend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint \"app/src/**/*.js\" \"tests/**/*.js\" \"*.config.js\"",
    "lint:css": "stylelint \"app/**/*.css\"",
    "format": "prettier --write \"app/**/*.{html,css,js}\" \"tests/**/*.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"app/**/*.{html,css,js}\" \"tests/**/*.js\" \"*.{js,json}\"",
    "check": "npm run lint && npm run lint:css && npm run build",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:deps": "playwright install-deps chromium",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.1.3"
  }
}
