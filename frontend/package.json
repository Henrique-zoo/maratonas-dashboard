{
  "name": "frontend",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint \"app/src/**/*.js\" \"tests/**/*.js\" \"*.config.js\"",
    "lint:css": "stylelint \"app/**/*.css\"",
    "format": "prettier --write \"app/**/*.{html,css,js}\" \"tests/**/*.js\" \"*.{js,json}\"",
    "format:check": "prettier --check \"app/**/*.{html,css,js}\" \"tests/**/*.js\" \"*.{js,json}\"",
    "quality": "bun run lint && bun run lint:css",
    "check": "bun run quality && bun run build && bun run test:coverage",
    "test:unit": "bun test tests/unit",
    "test:coverage": "bun test tests/unit --coverage",
    "test:contract": "bun test tests/contracts",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:list": "playwright test --list",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test --config playwright.fullstack.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.1.3"
  }
}
